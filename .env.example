# Long, random password for protected pages/routes. Keep this server-only.
PAGE_ACCESS_PASSWORD=replace-with-a-long-random-password

# Contact form destination email
CONTACT_EMAIL=your-email@example.com

# Resend API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx

# Sender address. Use a verified domain for production.
# Example: noreply@yourdomain.com
RESEND_FROM_EMAIL=onboarding@resend.dev
